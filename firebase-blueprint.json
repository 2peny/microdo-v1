{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated scholar user profile and credentials record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth user identifier (UID)"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the authenticated scholar"
        },
        "fullName": {
          "type": "string",
          "maxLength": 100,
          "description": "Real full name of the scholar"
        },
        "username": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "Clean unique username handle"
        },
        "role": {
          "type": "string",
          "enum": ["scholar", "guardian", "admin"],
          "description": "Primary account role; authorization is enforced by Firestore rules"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["LEARNER", "PARENT_GUARDIAN"]
          },
          "description": "Authorized platform role assignments for learner or guardian access; admin access is granted through the dedicated admin role"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "pending"],
          "description": "Account access state checked by Firestore rules"
        },
        "lastAdminEventId": {
          "type": "string",
          "description": "ID of the atomic audit event for the most recent admin access change"
        },
        "archetype": {
          "type": "string",
          "description": "Scholar study archetype identifier"
        },
        "archetypeLabel": {
          "type": "string",
          "description": "Human-readable label for archetype"
        },
        "avatarEmoji": {
          "type": "string",
          "description": "Emoji avatar character"
        },
        "majorOrFocus": {
          "type": "string",
          "maxLength": 100,
          "description": "Field of study or academic focus"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of profile registration"
        }
      },
      "required": ["id", "email", "fullName", "username", "role", "archetype"]
    },
    "GuardianLink": {
      "title": "Guardian relationship request",
      "type": "object",
      "properties": {
        "guardianId": { "type": "string" },
        "learnerEmail": { "type": "string", "format": "email" },
        "learnerId": { "type": "string" },
        "learnerDisplayName": { "type": "string", "maxLength": 100 },
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "history": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["guardianId", "learnerEmail", "status", "createdAt", "updatedAt", "history"]
    },
    "AdminAuditEvent": {
      "title": "Administrative account access event",
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "targetId": { "type": "string" },
        "action": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["actorId", "targetId", "action", "roles", "status", "timestamp"]
    },
    "AdminAccessRequest": {
      "title": "Admin access approval request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewEventId": { "type": "string" }
      },
      "required": ["userId", "email", "fullName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual account profiles keyed by Firebase Auth UID; role and status mutations are authorized by Firestore rules"
    },
    "/guardianLinks/{linkId}": {
      "schema": "GuardianLink",
      "description": "Consent requests. Guardian can create/revoke; matching verified learner can approve or reject. Access is enforced by Firestore rules."
    },
    "/adminAuditEvents/{eventId}": {
      "schema": "AdminAuditEvent",
      "description": "Admin account-role/status changes written atomically with the user profile update and readable only by an authorized admin."
    },
    "/adminAccessRequests/{userId}": {
      "schema": "AdminAccessRequest",
      "description": "New users may request admin access; only the configured Super Admin can approve or reject requests. Requests do not grant privileges while pending."
    }
  }
}
